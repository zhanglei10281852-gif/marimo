+        vendor.mkdir(parents=True)
+        new_dir.mkdir()
+        (vendor / f"{modname}.py").write_text("VALUE = 1\n")
+
+        vendor_root = os.path.normcase(str(vendor.resolve())) + os.sep
+        monkeypatch.setattr(
+            autoreload,
+            "_non_user_module_roots",
+            lambda: (vendor_root,),
+        )
+
+        saved_sys_path = sys.path[:]
